diff --git a/.github/workflows/build-istoreos-re-ss-01.yml b/.github/workflows/build-istoreos-re-ss-01.yml
index c2019b7..b97e83f 100644
--- a/.github/workflows/build-istoreos-re-ss-01.yml
+++ b/.github/workflows/build-istoreos-re-ss-01.yml
@@ -6,6 +6,7 @@ on:
 jobs:
   build:
     runs-on: ubuntu-22.04
+    timeout-minutes: 720
 
     steps:
       - name: Checkout build kit
@@ -14,7 +15,9 @@ jobs:
       - name: Free disk space
         run: |
           sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc
+          sudo apt-get clean
           docker system prune -af || true
+          df -h /
 
       - name: Install build dependencies
         run: |
@@ -35,14 +38,22 @@ jobs:
           WORK_DIR="$GITHUB_WORKSPACE/work" JOBS="$(nproc)" ./build-istoreos-re-ss-01.sh
 
       - name: Collect firmware
+        if: always()
         run: |
           mkdir -p artifact
-          cp work/istoreos/bin/targets/qualcommax/ipq60xx/*jdcloud_re-ss-01* artifact/ || true
-          cp work/istoreos/bin/targets/qualcommax/ipq60xx/sha256sums artifact/ || true
-          ls -lh artifact
+          # 收集固件文件
+          cp work/istoreos/bin/targets/qualcommax/ipq60xx/*jdcloud_re-ss-01* artifact/ 2>/dev/null || true
+          cp work/istoreos/bin/targets/qualcommax/ipq60xx/sha256sums artifact/ 2>/dev/null || true
+          # 收集编译日志（用于排查问题）
+          if [ -f work/istoreos/logs/ ]; then
+            tar czf artifact/build-logs.tar.gz -C work/istoreos logs/ 2>/dev/null || true
+          fi
+          ls -lh artifact/ || true
 
       - name: Upload firmware
+        if: always()
         uses: actions/upload-artifact@v4
         with:
           name: istoreos-jdcloud-re-ss-01
           path: artifact/
+          retention-days: 30
diff --git a/README.md b/README.md
index a5ef9c9..b081317 100644
--- a/README.md
+++ b/README.md
@@ -1,44 +1,39 @@
-# JDCloud RE-SS-01 定制 iStoreOS 编译包
+# JDCloud RE-SS-01 iStoreOS 编译包
 
-这个编译包用于给 `JDCloud RE-SS-01` 定制编译 iStoreOS 固件，目标是稳定优先，同时保留这台 IPQ60xx 设备的基础性能能力。
+为 `JDCloud RE-SS-01` 路由器编译 iStoreOS 固件。iStoreOS `istoreos-24.10` 分支已内置该设备的完整支持，无需额外补丁。
 
-## 适配目标
-
-你的路由器应匹配以下标识：
+## 设备标识
 
 ```text
 model=JDCloud RE-SS-01
 board=jdcloud_re-ss-01
 compatible=jdcloud,re-ss-01
 target=qualcommax/ipq60xx
+SOC=ipq6000
 ```
 
-不要使用 `jdcloud_ax1800-pro`、`ap-cp03-c1`、`jdcloud,ax1800-pro` 的固件直接刷这台机器。
-
 ## 编译包内容
 
 ```text
-patches/001-add-jdcloud-re-ss-01-support.patch
-files/board-jdcloud_re-ss-01.ipq6018
-configs/re-ss-01-stable.config
-build-istoreos-re-ss-01.sh
-.github/workflows/build-istoreos-re-ss-01.yml
+configs/re-ss-01-stable.config      # 编译配置（稳定优先）
+build-istoreos-re-ss-01.sh          # 本地编译脚本
+.github/workflows/build-istoreos-re-ss-01.yml  # GitHub Actions 云编译
 ```
 
-补丁包含：
+## 源码已内置的支持
 
-- 新增 `JDCloud RE-SS-01` 设备树。
-- 新增 `jdcloud_re-ss-01` 镜像目标。
-- 新增 `jdcloud,re-ss-01` LAN/WAN 初始化。
-- 新增 eMMC 双分区 `sysupgrade` 写入逻辑。
-- 新增 Wi-Fi 校准数据提取逻辑。
-- 新增 `ipq-wifi-jdcloud_re-ss-01` 固件包声明。
+iStoreOS `istoreos-24.10` 分支已包含以下 RE-SS-01 支持：
 
-## 本地编译
+- 设备树：`ipq6000-re-ss-01.dts`（LED、按键、eMMC、USB、网口）
+- Wi-Fi 板载数据：`board-jdcloud_re-ss-01.ipq6018`
+- ipq-wifi 固件包：`ipq-wifi-jdcloud_re-ss-01`
+- caldata 提取：eMMC ART 分区校准数据
+- 升级逻辑：eMMC 双分区（0:HLOS / 0:HLOS_1）sysupgrade
+- 网络配置：LAN1-3 + WAN
 
-建议使用 Ubuntu 22.04/24.04、至少 4 核 CPU、8GB 内存、80GB 可用磁盘空间。
+## 本地编译
 
-安装依赖后运行：
+**环境要求**：Ubuntu 22.04+、4 核 CPU、8GB 内存、80GB 磁盘
 
 ```sh
 chmod +x ./build-istoreos-re-ss-01.sh
@@ -51,61 +46,28 @@ chmod +x ./build-istoreos-re-ss-01.sh
 WORK_DIR=$HOME/istoreos-build JOBS=4 ./build-istoreos-re-ss-01.sh
 ```
 
-编译完成后检查：
+编译产物：
 
 ```sh
 ls -lh $HOME/istoreos-build/istoreos/bin/targets/qualcommax/ipq60xx/*jdcloud_re-ss-01*
 ```
 
-你要刷的是：
-
-```text
-*jdcloud_re-ss-01-squashfs-sysupgrade.bin
-```
+刷机使用 `*jdcloud_re-ss-01-squashfs-sysupgrade.bin`。
 
 ## GitHub Actions 云编译
 
-1. 新建一个 GitHub 仓库。
-2. 把本目录所有文件上传到仓库根目录。
-3. 打开 `Actions`。
-4. 选择 `Build iStoreOS for JDCloud RE-SS-01`。
-5. 点击 `Run workflow`。
-6. 编译完成后在 artifact 里下载固件。
-
-## 验包方法
-
-编译后先在电脑上检查：
-
-```sh
-tar -tf *jdcloud_re-ss-01*squashfs-sysupgrade.bin
-tar -xOf *jdcloud_re-ss-01*squashfs-sysupgrade.bin sysupgrade-jdcloud_re-ss-01/CONTROL
-strings -a *jdcloud_re-ss-01*squashfs-sysupgrade.bin | grep -E 'jdcloud_re-ss-01|jdcloud,re-ss-01|JDCloud RE-SS-01|supported_devices'
-```
-
-期望看到：
-
-```text
-sysupgrade-jdcloud_re-ss-01/
-BOARD=jdcloud_re-ss-01
-supported_devices:["jdcloud,re-ss-01"]
-```
-
-## 刷机建议
-
-- 只刷 `sysupgrade.bin`，不要用其他型号的 `factory.bin`。
-- 从你当前的 ImmortalWrt/OpenWrt 后台升级即可。
-- 第一次切换到这版定制 iStoreOS，建议不要保留配置。
-- 如果 LuCI 提示设备不兼容，不要强制刷。
-- 刷机前备份配置，并准备好 TTL/U-Boot 救砖方案。
-
-## 稳定和性能取舍
+1. 新建 GitHub 仓库，将本目录所有文件上传到根目录
+2. 打开 `Actions` → 选择 `Build iStoreOS for JDCloud RE-SS-01`
+3. 点击 `Run workflow`
+4. 编译完成后在 Artifacts 下载固件
 
-这个配置没有默认内置 OpenClash、AdGuardHome、Docker 等重型插件。建议系统刷好并稳定运行后，再通过 iStore 逐个安装需要的插件。
+## 刷机须知
 
-要发挥性能，优先使用：
+- 只刷 `sysupgrade.bin`，不要用其他型号的 `factory.bin`
+- 从当前 ImmortalWrt/OpenWrt 后台直接 sysupgrade 升级
+- 首次切换到 iStoreOS 建议不保留配置
+- 刷机前备份配置，准备 TTL/U-Boot 救砖方案
 
-- 有线主路由场景下开启系统自带的硬件/NSS 加速能力。
-- 插件少装、按需安装。
-- 不要同时运行多个高负载代理、广告过滤和 Docker 容器。
+## 稳定优先策略
 
-如果你追求极限 NSS 性能，可以后续再做专门的 NSS/ECM 优化分支；稳定优先时，不建议一开始就叠加大量第三方加速补丁。
+配置未内置 OpenClash、AdGuardHome、Docker 等重型插件。建议系统稳定运行后通过 iStore 按需安装。
diff --git a/build-istoreos-re-ss-01.sh b/build-istoreos-re-ss-01.sh
index a1b5f0c..5b68a0c 100644
--- a/build-istoreos-re-ss-01.sh
+++ b/build-istoreos-re-ss-01.sh
@@ -7,40 +7,79 @@ SRC_DIR="$WORK_DIR/istoreos"
 BRANCH="${BRANCH:-istoreos-24.10}"
 JOBS="${JOBS:-$(nproc)}"
 
-echo "工作目录: $WORK_DIR"
+echo "========================================"
+echo "  iStoreOS 固件编译 — JDCloud RE-SS-01"
+echo "  分支: $BRANCH"
+echo "  并行: $JOBS 线程"
+echo "  工作目录: $WORK_DIR"
+echo "========================================"
+
 mkdir -p "$WORK_DIR"
 
+# ── 1. 克隆 / 更新源码 ──────────────────────────────────────
 if [ ! -d "$SRC_DIR/.git" ]; then
-  git clone --depth 1 --branch "$BRANCH" https://github.com/istoreos/istoreos "$SRC_DIR"
+  echo "[1/6] 克隆 iStoreOS 源码…"
+  git clone --depth 1 --branch "$BRANCH" \
+    https://github.com/istoreos/istoreos.git "$SRC_DIR"
 else
+  echo "[1/6] 更新 iStoreOS 源码…"
   git -C "$SRC_DIR" fetch --depth 1 origin "$BRANCH"
   git -C "$SRC_DIR" checkout "$BRANCH"
   git -C "$SRC_DIR" reset --hard "origin/$BRANCH"
 fi
 
-echo "应用 JDCloud RE-SS-01 设备支持补丁"
-git -C "$SRC_DIR" apply "$ROOT_DIR/patches/001-add-jdcloud-re-ss-01-support.patch"
+# ── 2. 确认设备支持已存在 ──────────────────────────────────
+echo "[2/6] 确认 RE-SS-01 设备支持…"
+DTS_FILE="$SRC_DIR/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq6000-re-ss-01.dts"
+BOARD_FILE="$SRC_DIR/package/firmware/ipq-wifi/files/board-jdcloud_re-ss-01.ipq6018"
 
-echo "复制 RE-SS-01 Wi-Fi board data"
-mkdir -p "$SRC_DIR/package/firmware/ipq-wifi/files"
-cp "$ROOT_DIR/files/board-jdcloud_re-ss-01.ipq6018" "$SRC_DIR/package/firmware/ipq-wifi/files/"
+if [ ! -f "$DTS_FILE" ]; then
+  echo "  ✗ 设备树文件不存在: $DTS_FILE"
+  echo "  请确认分支 $BRANCH 已包含 RE-SS-01 支持"
+  exit 1
+fi
+if [ ! -f "$BOARD_FILE" ]; then
+  echo "  ✗ Wi-Fi 板载数据不存在: $BOARD_FILE"
+  echo "  请确认分支 $BRANCH 已包含 RE-SS-01 支持"
+  exit 1
+fi
+echo "  ✓ 设备树已就绪"
+echo "  ✓ Wi-Fi 板载数据已就绪"
+echo "  ✓ 无需额外补丁 — 源码已内置 RE-SS-01 支持"
 
-echo "更新 feeds"
+# ── 3. 更新 feeds ──────────────────────────────────────────
+echo "[3/6] 更新 feeds…"
 cd "$SRC_DIR"
 ./scripts/feeds update -a
 ./scripts/feeds install -a
 
-echo "写入稳定优先配置"
+# ── 4. 写入配置 ────────────────────────────────────────────
+echo "[4/6] 写入编译配置…"
 cp "$ROOT_DIR/configs/re-ss-01-stable.config" .config
 make defconfig
 
-echo "开始下载源码包"
+# ── 5. 下载源码包 ──────────────────────────────────────────
+echo "[5/6] 下载源码包…"
 make download -j"$JOBS"
 
-echo "开始编译，首次编译通常需要数小时"
-make -j"$JOBS" V=s
+# ── 6. 编译 ────────────────────────────────────────────────
+echo "[6/6] 开始编译（首次编译通常 1-3 小时）…"
+
+# 安全措施：禁用 -Werror，避免因编译器警告导致编译中断
+export EXTRA_CFLAGS="-Wno-error"
+export EXTRA_CXXFLAGS="-Wno-error"
+
+# 先用多线程编译；失败时用单线程 + 详细日志重试，便于定位错误
+if ! make -j"$JOBS"; then
+  echo "⚠ 多线程编译失败，切换到单线程详细模式重试…"
+  make -j1 V=s
+fi
 
+# ── 输出结果 ───────────────────────────────────────────────
 echo
-echo "编译完成。请检查以下输出："
+echo "========================================"
+echo "  编译完成！固件文件："
+echo "========================================"
 find "$SRC_DIR/bin/targets/qualcommax/ipq60xx" -maxdepth 1 -type f \
-  \( -name "*jdcloud_re-ss-01*" -o -name "sha256sums" \) -print
+  \( -name "*jdcloud_re-ss-01*" -o -name "sha256sums" \) \
+  -exec ls -lh {} \;
